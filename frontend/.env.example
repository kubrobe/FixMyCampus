# FixMyCampus frontend environment variables
# Copy this file to `.env` (or `.env.local`) and fill in real values locally.
# Never commit real values. Only variables prefixed with VITE_ are exposed
# to the browser, so never put server-side secrets here.

# Display name shown in the UI
VITE_APP_NAME=FixMyCampus

# --- Future integrations (not used yet) ---
# Supabase project URL and public anon key (Mission: backend integration)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Base URL of the future FastAPI classification service
VITE_AI_SERVICE_URL=http://localhost:8000
